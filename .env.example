# ================================================================================
# ASOPALAV ERP - ENVIRONMENT CONFIGURATION (Zero Client Secrets)
# Copy this file to .env and fill in your actual values
# ================================================================================

# 1. Supabase PostgreSQL & Auth (Safe Public Publishable Key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key-here
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# 2. Cloudflare R2 Public Storage Configuration
VITE_CLOUDFLARE_ACCOUNT_ID=your-account-id
VITE_R2_BUCKET_NAME=asopalav-erp-media
VITE_R2_PUBLIC_DOMAIN=https://pub-your-id.r2.dev

# ================================================================================
# SERVER-SIDE ONLY SECRETS (NEVER prefix with VITE_ — kept strictly in Edge Functions)
# supabase secrets set R2_ACCOUNT_ID=your-account-id R2_ACCESS_KEY_ID=your-key R2_SECRET_ACCESS_KEY=your-secret R2_BUCKET_NAME=asopalav-erp-media R2_PUBLIC_DOMAIN=https://pub-your-id.r2.dev
# ================================================================================
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
